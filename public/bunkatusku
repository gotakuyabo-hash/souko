                            <input type="text" value="${row.jpName}" onchange="processedDataRows[${i}].jpName=this.value" class="border rounded px-2 py-1 w-full text-xs font-bold bg-white">
                        </div>
                        <div class="text-[11px] text-slate-500 whitespace-normal break-all"><b>元情報:</b> ${row.item}</div>
                    </td>
