                                    <th class="px-4 py-3">Order SN</th>
                                    <th class="px-4 py-3">SKUコード (コピー可)</th>
                                    <th class="px-4 py-3 min-w-[320px]">商品情報（和名・元情報）</th>
                                    <th class="px-4 py-3 text-center">Base</th>
                                    <th class="px-4 py-3 text-center">倍率</th>
                                    <th class="px-4 py-3 text-center">総数</th>
                                    <th class="px-4 py-3 text-center">操作</th>
                                </tr>
                            </thead>
                            <tbody id="previewBody" class="divide-y divide-slate-100 text-slate-700"></tbody>
                        </table>
                    </div>
                </div>
            </div>
