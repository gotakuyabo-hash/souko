                        <button onclick="addModalItemRow()" class="bg-indigo-50 text-indigo-600 hover:bg-indigo-100 px-2.5 py-1 rounded font-medium"><i class="fa-solid fa-plus mr-1"></i>商品を追加</button>
                    </div>
                    <div id="modalItemsContainer" class="space-y-2 border p-3 rounded-xl bg-slate-50/50 max-h-60 overflow-y-auto">
                        <!-- 動的に商品行が追加されます -->
                    </div>
                </div>
            </div>
            <div class="flex justify-end space-x-2 pt-3 border-t">
                <button onclick="closeMasterModal()" class="bg-slate-100 px-4 py-2 rounded text-xs">キャンセル</button>
                <button onclick="saveMasterToFirestore()" class="bg-indigo-600 text-white px-4 py-2 rounded text-xs font-medium">Firestoreに保存</button>
            </div>
        </div>
    </div>

    <!-- シート貼り付け用コピモーダル -->
    <div id="sheetCopyModal" class="hidden fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full p-6 space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-bold text-sm"><i class="fa-solid fa-paste text-purple-600 mr-2"></i>シート貼り付け用データ (order_sn, product_name_jp, total_quantity)</h3>
                <button onclick="closeSheetCopyModal()"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <p class="text-xs text-slate-500">以下のボックス内を選択してコピーするか、ボタンをクリックしてクリップボードにコピーしてください。</p>
            <div>
                <textarea id="sheetCopyTextarea" rows="10" class="w-full font-mono text-xs border rounded-xl p-3 bg-slate-50 select-all" readonly></textarea>
            </div>
            <div class="flex justify-end space-x-2 pt-2 border-t">
                <button onclick="closeSheetCopyModal()" class="bg-slate-100 px-4 py-2 rounded text-xs">閉じる</button>
                <button onclick="copySheetDataToClipboard()" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded text-xs font-medium"><i class="fa-regular fa-copy mr-1"></i>一括コピーする</button>
            </div>
        </div>
    </div>

    <!-- 検品書モーダル -->
    <div id="inspectionModal" class="hidden fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-3xl w-full p-6 space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b pb-3 no-print">
                <h3 class="font-bold"><i class="fa-solid fa-print text-amber-600 mr-2"></i>検品書プレビュー (100mm×150mm)</h3>
                <div class="flex space-x-2">
                    <button onclick="printInspection()" class="bg-amber-600 hover:bg-amber-700 text-white text-xs px-3 py-1.5 rounded font-medium"><i class="fa-solid fa-print mr-1"></i>検品書を印刷</button>
                    <button onclick="closeInspectionModal()"><i class="fa-solid fa-xmark"></i></button>
                </div>
            </div>
            <div id="inspectionPrintArea" class="space-y-6"></div>
        </div>
    </div>

    <!-- トータルピックリストモーダル -->
    <div id="totalPickingModal" class="hidden fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-3xl w-full p-6 space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b pb-3 no-print">
                <h3 class="font-bold"><i class="fa-solid fa-clipboard-list text-blue-600 mr-2"></i>トータルピックリスト</h3>
                <div class="flex space-x-2">
                    <button onclick="printPicking()" class="bg-blue-600 hover:bg-blue-700 text-white text-xs px-3 py-1.5 rounded font-medium"><i class="fa-solid fa-print mr-1"></i>ピックリストを印刷</button>
                    <button onclick="closeTotalPickingModal()"><i class="fa-solid fa-xmark"></i></button>
                </div>
            </div>
            <div class="overflow-x-auto border rounded-xl">
                <table class="w-full text-left border-collapse text-xs">
                    <thead class="bg-slate-100 border-b">
                        <tr><th class="px-4 py-3">棚番</th><th class="px-4 py-3">商品名</th><th class="px-4 py-3 text-center">必要総数量</th></tr>
                    </thead>
                    <tbody id="totalPickingBody" class="divide-y"></tbody>
                </table>
            </div>
        </div>
    </div>

