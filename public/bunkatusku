                            <tr>
                                <th class="px-4 py-3">SKUコード (コピー可)</th>
                                <th class="px-4 py-3">紐付く商品・棚番・数量構成</th>
                                <th class="px-4 py-3 text-right">操作</th>
                            </tr>
                        </thead>
                        <tbody id="masterTableBody" class="divide-y"></tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <!-- マスタ登録・編集モーダル -->
    <div id="masterModal" class="hidden fixed inset-0 bg-slate-900/50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-2xl w-full p-6 space-y-4 max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b pb-3">
