        function setupFileHandlers() {
            const drop = document.getElementById('dropZone');
            const input = document.getElementById('fileInput');
            drop.addEventListener('dragover', e => e.preventDefault());
            drop.addEventListener('drop', e => { e.preventDefault(); if (e.dataTransfer.files.length) handleFiles(e.dataTransfer.files); });
            input.addEventListener('change', e => { if (e.target.files.length) handleFiles(e.target.files); });
        }

        function handleFiles(files) {
            document.getElementById('loadingState').classList.remove('hidden');
            let loaded = 0;
            const listEl = document.getElementById('fileList');
            document.getElementById('fileListContainer').classList.remove('hidden');

            Array.from(files).forEach(file => {
                const reader = new FileReader();
                reader.onload = e => {
                    try {
                        const wb = XLSX.read(new Uint8Array(e.target.result), { type: 'array' });
                        const rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { header: 1 });
                        if (rows.length) {
                            allFilesRawData.push({ name: file.name, rows });
                            const li = document.createElement('li');
                            li.innerHTML = `<i class="fa-solid fa-file-excel text-emerald-600 mr-1"></i>${file.name} (${rows.length - 1}行)`;
                            listEl.appendChild(li);
                        }
                    } catch (err) { alert('読込失敗'); }
                    if (++loaded === files.length) {
                        document.getElementById('loadingState').classList.add('hidden');
                        processAllData();
                    }
                };
                reader.readAsArrayBuffer(file);
            });
        }

        function extractSku(text) {
            if (!text) return "";
            let m = text.match(/SKU\s*Reference\s*No\.?:\s*([^;]+)/i) || text.match(/商品選項貨號:\s*([^;]+)/i);
            return m ? m[1].trim() : "";
        }

        function processItemText(trackingNum, orderSn, productInfo) {
            const sku = extractSku(productInfo);
            
            let matched = multiplierMaster.find(r => r.key.toLowerCase() === sku.toLowerCase());
            if (!matched && sku) {
                matched = multiplierMaster.find(r => productInfo.includes(r.key) || sku.includes(r.key));
            }

            let results = [];
            if (matched && matched.items && matched.items.length > 0) {
                matched.items.forEach(it => {
                    results.push({
                        trackingNum,
                        orderSn,
                        sku,
                        item: productInfo,
                        jpName: it.jpName,
                        shelf: it.shelf || '',
                        baseQty: 1,
                        multiplier: it.multiplier || 1
                    });
                });
            } else {
                results.push({
                    trackingNum,
                    orderSn,
                    sku,
                    item: productInfo,
                    jpName: productInfo,
                    shelf: '',
                    baseQty: 1,
                    multiplier: 1
                });
            }

            return results;
        }

        function processAllData() {
            processedDataRows = [];
            allFilesRawData.forEach(fileObj => {
                fileObj.rows.slice(1).forEach(row => {
                    const trackingNum = row[0] !== undefined ? row[0] : "";
                    const orderSn = row[1] !== undefined ? row[1] : "";
                    const productInfo = row[2] !== undefined ? String(row[2]) : "";
                    if (!productInfo.trim()) return;

                    productInfo.split(/\r?\n/).forEach(item => {
                        if (item.trim()) processedDataRows.push(...processItemText(trackingNum, orderSn, item.trim()));
                    });
                });
            });
            renderResults();
        }

        function renderResults() {
            document.getElementById('resultSection').classList.remove('hidden');
            document.getElementById('resultSubtitle').innerText = `合計 ${processedDataRows.length} 行`;
            document.getElementById('rowCountBadge').innerText = `全 ${processedDataRows.length} 行`;
            
            const tbody = document.getElementById('previewBody');
            tbody.innerHTML = '';

            processedDataRows.forEach((row, i) => {
                const total = row.baseQty * row.multiplier;
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50';
                
                let skuCellHtml = row.sku ? `
