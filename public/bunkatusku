                        <button onclick="loadDefaultPresets()" class="bg-indigo-50 text-indigo-700 px-3 py-2 rounded-lg border border-indigo-200 font-medium">初期プリセット一括登録</button>
                        <button onclick="clearMasterFirestore()" class="text-rose-600 px-3 py-2 rounded-lg border border-rose-200 hover:bg-rose-50 font-medium">全クリア</button>
                    </div>
                </div>
                <div class="flex gap-3 bg-slate-50 p-4 rounded-xl border items-center">
                    <div class="relative flex-grow">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400"></i>
                        <input type="text" id="masterSearchInput" oninput="renderMasterTable()" placeholder="SKU、商品名で検索..." class="w-full text-sm border rounded-lg pl-9 pr-3 py-2 bg-white">
                    </div>
                    <button onclick="openMasterEditModal(-1)" class="bg-indigo-600 hover:bg-indigo-700 text-white text-xs py-2.5 px-4 rounded-lg font-medium"><i class="fa-solid fa-plus mr-1"></i>新規登録</button>
                </div>
                <div class="overflow-x-auto max-h-[600px] border rounded-xl">
                    <table class="w-full text-left border-collapse text-xs">
