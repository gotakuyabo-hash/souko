<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">

    <header class="bg-indigo-700 text-white shadow-md no-print">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center space-x-3">
                <i class="fa-solid fa-cloud-arrow-up text-2xl"></i>
                <h1 class="text-xl font-bold">受注データ自動分割 ＆ Firestoreマスタ管理ツール</h1>
            </div>
            <div class="flex bg-indigo-900/60 p-1 rounded-xl">
                <button onclick="switchTab('orders')" id="tabBtnOrders" class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-white text-indigo-900 shadow-sm">受注処理</button>
                <button onclick="switchTab('master')" id="tabBtnMaster" class="px-4 py-1.5 rounded-lg text-xs font-semibold text-indigo-100 hover:text-white">商品マスタ管理 (<span id="masterCountBadge">0</span>)</button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full space-y-6">
        
        <!-- 受注処理タブ -->
        <div id="tabContentOrders" class="space-y-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 space-y-4">
                <div class="flex justify-between items-center">
                    <h2 class="text-lg font-semibold"><i class="fa-solid fa-file-excel text-emerald-600 mr-2"></i>パッキングリスト（複数Excel一括）</h2>
                    <button onclick="resetApp()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 px-3 py-1.5 rounded-lg"><i class="fa-solid fa-rotate-right mr-1"></i>リセット</button>
                </div>
                <label id="dropZone" for="fileInput" class="border-2 border-dashed border-slate-300 hover:border-indigo-500 bg-slate-50 rounded-xl p-8 text-center cursor-pointer block">
                    <input type="file" id="fileInput" accept=".xlsx, .xls, .csv" multiple class="hidden">
                    <div class="flex flex-col items-center space-y-2">
                        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-full flex items-center justify-center text-lg"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                        <p class="text-sm font-semibold text-slate-700">Excelファイルをここにドラッグ＆ドロップ、またはクリックして選択</p>
                    </div>
                </label>
                <div id="fileListContainer" class="hidden space-y-1">
                    <h4 class="text-xs font-semibold text-slate-600">読み込み済みファイル:</h4>
                    <ul id="fileList" class="text-xs text-slate-700 space-y-1"></ul>
                </div>
            </div>

            <div id="loadingState" class="hidden bg-white rounded-xl p-12 text-center">
                <i class="fa-solid fa-circle-notch fa-spin text-3xl text-indigo-600"></i>
                <p class="text-sm text-slate-600 mt-2">処理中...</p>
            </div>

            <div id="resultSection" class="hidden space-y-6">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 flex flex-wrap justify-between items-center gap-4">
                    <div>
                        <h3 class="text-lg font-bold" id="resultTitle">処理完了</h3>
                        <p class="text-sm text-slate-500" id="resultSubtitle">合計 0 行</p>
                    </div>
                    <div class="flex flex-wrap gap-2 text-xs">
                        <button onclick="registerAllToMaster()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3.5 py-2.5 rounded-xl font-medium"><i class="fa-solid fa-database mr-1"></i>Firestore一括登録</button>
                        <button onclick="openSheetCopyModal()" class="bg-purple-600 hover:bg-purple-700 text-white px-3.5 py-2.5 rounded-xl font-medium"><i class="fa-solid fa-paste mr-1"></i>シート用データコピー</button>
                        <button onclick="openInspectionModal()" class="bg-amber-600 hover:bg-amber-700 text-white px-3.5 py-2.5 rounded-xl font-medium"><i class="fa-solid fa-print mr-1"></i>検品書(100×150)印刷</button>
                        <button onclick="openTotalPickingModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-3.5 py-2.5 rounded-xl font-medium"><i class="fa-solid fa-clipboard-list mr-1"></i>トータルピック</button>
                        <button onclick="downloadExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2.5 rounded-xl font-medium"><i class="fa-solid fa-file-excel mr-1"></i>Excel保存</button>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
                        <span id="rowCountBadge" class="text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full font-medium"></span>
                        <button onclick="sortRowsByProduct()" class="text-xs bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg"><i class="fa-solid fa-arrow-down-a-z mr-1"></i>商品名順ソート</button>
                    </div>
                    <div class="overflow-x-auto max-h-[600px]">
