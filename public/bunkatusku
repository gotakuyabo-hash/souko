            </div>
            <input type="hidden" id="editMasterIndex" value="-1">
            <div class="space-y-4 text-xs">
                <div>
                    <label class="font-semibold block mb-1">SKUコード</label>
                    <input type="text" id="modalKey" class="w-full border rounded px-3 py-2 font-mono bg-slate-50">
                </div>
                
                <div class="space-y-2">
                    <div class="flex justify-between items-center">
