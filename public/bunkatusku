            if (items.length === 0) { alert('有効な商品名を入力してください'); return; }

            const newData = { key, items };

            try {
                await window.firebaseFns.setDoc(window.firebaseFns.doc(window.db, "products_master", key), newData);
                await window.initFirestoreMaster();
                closeMasterModal();
                if (allFilesRawData.length > 0) processAllData();
