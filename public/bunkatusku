            if (!processedDataRows.length) return;
            let lines = ["order_sn\tproduct_name_jp\ttotal_quantity"];
            processedDataRows.forEach(r => {
                let total = r.baseQty * r.multiplier;
                lines.push(`${r.orderSn}\t${r.jpName}\t${total}`);
            });
            document.getElementById('sheetCopyTextarea').value = lines.join('\n');
            document.getElementById('sheetCopyModal').classList.remove('hidden');
        }

        function closeSheetCopyModal() {
            document.getElementById('sheetCopyModal').classList.add('hidden');
        }

        function copySheetDataToClipboard() {
            const textarea = document.getElementById('sheetCopyTextarea');
            textarea.select();
            textarea.setSelectionRange(0, 999999);
            navigator.clipboard.writeText(textarea.value).then(() => {
                const toast = document.getElementById('toast');
                toast.classList.remove('hidden');
                setTimeout(() => { toast.classList.add('hidden'); }, 1500);
            }).catch(err => { alert('コピーに失敗しました'); });
        }

        function openInspectionModal() {
            if (!processedDataRows.length) return;
            const area = document.getElementById('inspectionPrintArea');
            area.innerHTML = '';
            let map = {};
            processedDataRows.forEach(r => {
                let sn = r.orderSn || "UNKNOWN";
                if (!map[sn]) map[sn] = { tracking: r.trackingNum, items: [] };
                map[sn].items.push(r);
            });

            Object.keys(map).forEach(sn => {
                let o = map[sn];
                let slip = document.createElement('div');
                slip.className = "inspection-slip bg-white border-2 border-slate-800 p-4 rounded-xl mx-auto mb-6 shadow-sm";
                slip.style.width = "100mm"; 
                slip.style.minHeight = "150mm";
                
                let itemsHtml = o.items.map(it => `
                    <tr class="border-b text-xs">
                        <td class="py-2.5 px-1 font-bold">${it.jpName}<br><span class="text-[9px] text-slate-500 font-normal">棚: ${it.shelf||'-'} | SKU: ${it.sku||'-'}</span></td>
                        <td class="py-2.5 px-1 text-center font-bold text-indigo-600 text-sm">${it.baseQty*it.multiplier}</td>
                    </tr>
                `).join('');

                slip.innerHTML = `
                    <div class="flex justify-between border-b-2 border-slate-800 pb-2 mb-3">
                        <div><div class="text-[10px] text-slate-500 font-bold">ORDER SN</div><div class="text-xs font-mono font-bold">${sn}</div></div>
                        <div class="text-right"><div class="text-[10px] text-slate-500 font-bold">TRACKING NO</div><div class="text-xs font-mono font-bold">${o.tracking}</div></div>
                    </div>
                    <table class="w-full text-left border-collapse mb-4">
                        <thead>
                            <tr class="bg-slate-100 text-[10px] text-slate-600 border-b">
                                <th class="py-1.5 px-1">商品名</th>
                                <th class="py-1.5 px-1 text-center w-12">数量</th>
                            </tr>
                        </thead>
                        <tbody>${itemsHtml}</tbody>
                    </table>
                    <div class="text-center pt-4 border-t border-dashed text-[10px] text-slate-400 mt-auto">検品確認印: [ &nbsp; &nbsp; &nbsp; ]</div>
                `;
                area.appendChild(slip);
            });
            document.getElementById('inspectionModal').classList.remove('hidden');
        }

        function closeInspectionModal() { document.getElementById('inspectionModal').classList.add('hidden'); }

        function printInspection() {
            document.body.classList.add('printing-inspection');
            window.print();
            document.body.classList.remove('printing-inspection');
        }

        function openTotalPickingModal() {
            if (!processedDataRows.length) return;
            let map = {};
            processedDataRows.forEach(r => {
                let k = (r.shelf || '未設定') + "_" + r.jpName;
                if (!map[k]) map[k] = { shelf: r.shelf || '未設定', name: r.jpName, total: 0 };
                map[k].total += r.baseQty * r.multiplier;
            });
            let sorted = Object.values(map).sort((a,b) => a.shelf.localeCompare(b.shelf));
            document.getElementById('totalPickingBody').innerHTML = sorted.map(x => `<tr class="hover:bg-slate-50"><td class="px-4 py-2 font-bold text-indigo-700">${x.shelf}</td><td class="px-4 py-2 font-semibold">${x.name}</td><td class="px-4 py-2 text-center font-bold text-emerald-600 text-base">${x.total}</td></tr>`).join('');
            document.getElementById('totalPickingModal').classList.remove('hidden');
        }

        function closeTotalPickingModal() { document.getElementById('totalPickingModal').classList.add('hidden'); }

        function printPicking() {
            document.body.classList.add('printing-picking');
            window.print();
            document.body.classList.remove('printing-picking');
        }

        function downloadExcel() {
            if (!processedDataRows.length) return;
            let data = [['tracking_number', 'order_sn', 'sku_code', 'product_name_jp', 'original_product_info', 'base_quantity', 'multiplier', 'total_quantity']];
            processedDataRows.forEach(r => data.push([r.trackingNum, r.orderSn, r.sku, r.jpName, r.item, r.baseQty, r.multiplier, r.baseQty*r.multiplier]));
            let ws = XLSX.utils.aoa_to_sheet(data);
            let wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "処理結果");
            XLSX.writeFile(wb, `受注データ_処理結果_${new Date().toISOString().slice(0,10)}.xlsx`);
        }

        function resetApp() {
            allFilesRawData = []; processedDataRows = [];
            document.getElementById('fileInput').value = '';
            document.getElementById('fileList').innerHTML = '';
            document.getElementById('fileListContainer').classList.add('hidden');
            document.getElementById('loadingState').classList.add('hidden');
            document.getElementById('resultSection').classList.add('hidden');
        }
    </script>
</body>
</html>
