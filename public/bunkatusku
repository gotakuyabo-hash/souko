                `;
                tbody.appendChild(tr);
            });
        }

        function updateMult(i, val) {
            processedDataRows[i].multiplier = parseInt(val, 10) || 1;
            document.getElementById(`total-${i}`).innerText = processedDataRows[i].baseQty * processedDataRows[i].multiplier;
        }

        async function registerRowFromPreview(i) {
            const r = processedDataRows[i];
            if (!r.sku) { alert('SKUがありません'); return; }
            
            let m = multiplierMaster.find(x => x.key.toLowerCase() === r.sku.toLowerCase());
            let items = m ? [...m.items] : [];
            let existingItem = items.find(it => it.jpName === r.jpName);
            
            if (existingItem) {
                existingItem.multiplier = r.multiplier;
                existingItem.shelf = r.shelf;
            } else {
                items.push({ jpName: r.jpName, shelf: r.shelf, multiplier: r.multiplier });
            }

            const newData = { key: r.sku, items };
            try {
                await window.firebaseFns.setDoc(window.firebaseFns.doc(window.db, "products_master", r.sku), newData);
                await window.initFirestoreMaster();
                alert('Firestoreのマスタに登録しました');
            } catch (e) {
                console.error(e);
                alert('登録に失敗しました');
            }
        }

        async function registerAllToMaster() {
            try {
                for (let r of processedDataRows) {
                    if (!r.sku) continue;
                    let m = multiplierMaster.find(x => x.key.toLowerCase() === r.sku.toLowerCase());
                    let items = m ? [...m.items] : [];
                    let existingItem = items.find(it => it.jpName === r.jpName);
                    
                    if (existingItem) {
                        existingItem.multiplier = r.multiplier;
                        existingItem.shelf = r.shelf;
                    } else {
                        items.push({ jpName: r.jpName, shelf: r.shelf, multiplier: r.multiplier });
                    }

                    const newData = { key: r.sku, items };
                    await window.firebaseFns.setDoc(window.firebaseFns.doc(window.db, "products_master", r.sku), newData);
                }
                await window.initFirestoreMaster();
                alert('すべての行をFirestoreのマスタに一括登録しました');
            } catch (e) {
                console.error(e);
                alert('一括登録に失敗しました');
            }
        }

