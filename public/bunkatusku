                multiplierMaster = [];
                querySnapshot.forEach((docSnap) => {
                    multiplierMaster.push(docSnap.data());
                });

                // Firestoreが空の場合、デフォルトプリセットを自動登録する
                if (multiplierMaster.length === 0) {
                    for (let preset of DEFAULT_PRESETS) {
                        await window.firebaseFns.setDoc(window.firebaseFns.doc(window.db, "products_master", preset.key), preset);
                        multiplierMaster.push(preset);
                    }
